+static void single_trigger_draw(void)
+{
+ YuzuTrigger rt={0};
+ yuzu_trigger_sample(&rt,YUZU_PAD_ZR);
+ yuzu_trigger_sample(&rt,YUZU_PAD_ZR);
+ assert(yuzu_trigger_take(&rt)&&!yuzu_trigger_take(&rt));
+ yuzu_trigger_sample(&rt,YUZU_PAD_ZR);
+ assert(!yuzu_trigger_take(&rt));
+ yuzu_trigger_sample(&rt,YUZU_PAD_ZL|YUZU_PAD_ZR);
+ yuzu_trigger_sample(&rt,YUZU_PAD_ZR);
+ assert(rt.blocked&&!yuzu_trigger_take(&rt));
+ yuzu_trigger_sample(&rt,0);
+ yuzu_trigger_sample(&rt,0x100|YUZU_PAD_ZR); /* LB opens the wheel. */
+ assert(!yuzu_trigger_take(&rt));
+ yuzu_trigger_sample(&rt,0);
+ yuzu_trigger_sample(&rt,YUZU_PAD_ZR|0x10000); /* Stick direction is allowed. */
+ assert(!rt.blocked&&yuzu_trigger_take(&rt));
+
+ yuzu_trigger_sample(&rt,0);
+ yuzu_trigger_sample(&rt,YUZU_PAD_ZR);
+ const unsigned native=YUZU_PAD_R|YUZU_PAD_AX;
+ assert(yuzu_zr_input(yuzu_aerial_spirit_input(YUZU_PAD_ZR,&rt,1),1,0)==native);
+ assert(yuzu_zr_input(yuzu_aerial_spirit_input(YUZU_PAD_ZR,&rt,0),1,0)==0);
+ assert(yuzu_aerial_spirit_input(YUZU_PAD_ZR|0x100,&rt,1)==(YUZU_PAD_ZR|0x100));
+ assert(yuzu_trigger_take(&rt));
+ assert(yuzu_aerial_spirit_input(YUZU_PAD_ZR,&rt,1)==YUZU_PAD_ZR);
+ yuzu_trigger_sample(&rt,YUZU_PAD_ZL|YUZU_PAD_ZR);
+ assert(yuzu_aerial_spirit_input(YUZU_PAD_ZR,&rt,1)==YUZU_PAD_ZR);
+ assert(yuzu_zr_input(YUZU_PAD_ZR|YUZU_PAD_AX,1,0)==native);
+}
