+static void hunter_art_priority(void)
+{
+ const unsigned face_buttons[]={0x1000,0x8000,0x4000}; /* Xbox Y, X, A */
+ const unsigned actor_faces[]={GU_ACTOR_X,GU_ACTOR_Y,GU_ACTOR_B};
+ const unsigned art_faces[]={GU_ACTOR_X,GU_ACTOR_A,GU_ACTOR_B};
+ for(unsigned i=0;i<3;i++){
+  unsigned face=face_buttons[i],spent=0,chord=YUZU_PAD_ZL|face;
+  assert(yuzu_type2_art_input(GU_ACTOR_ZL|actor_faces[i],1,0)==(GU_ACTOR_ZL|art_faces[i]));
+  assert(yuzu_type2_art_input(actor_faces[i],0,actor_faces[i])==0);
+  assert(yuzu_type2_art_input(actor_faces[i],0,0)==actor_faces[i]);
+  assert(yuzu_zr_input(chord,1,1)==chord);
+  assert(yuzu_zr_input(chord|YUZU_PAD_ZR,1,1)==chord);
+  assert(yuzu_weapon_input(YUZU_PAD_ZL,&spent)==YUZU_PAD_ZL);
+  assert(yuzu_weapon_input(chord,&spent)==YUZU_PAD_ZL);
+  assert(yuzu_weapon_input(face,&spent)==0);
+  assert(yuzu_weapon_input(0,&spent)==0);
+  assert(yuzu_weapon_input(face,&spent)==face);
+  assert(yuzu_weapon_input(chord,&spent)==YUZU_PAD_ZL);
+  assert(yuzu_weapon_input(YUZU_PAD_ZL,&spent)==YUZU_PAD_ZL&&spent==0);
+ }
+ assert(yuzu_type2_art_input(GU_ACTOR_ZL|GU_ACTOR_A,1,0)==GU_ACTOR_ZL);
+ WObservation o=obs();
+ WState s={.actor=1,.epoch=1};
+ WDecision d=w_wilds_enter(&s,&o,W_CHIJIN);
+ o.base.native_action=w_action(d.move);o.base.motion=0x500+d.slot;
+ assert(frame_step(&s,&o,ML_X,40).kind==W_KEEP&&s.wilds_buffer>0);
+ o.hunter_art_input=1;
+ assert(frame_step(&s,&o,0,45).kind==W_KEEP&&s.wilds_buffer==0);
+ o.hunter_art_input=0;
+ assert(frame_step(&s,&o,0,46).kind==W_KEEP&&s.source==W_CRIMSON_STATIONARY);
+ assert(frame_step(&s,&o,ML_X,47).source==906);
+}
