+static void sprint_and_weapon_packets(void)
+{
+    const unsigned rb=YUZU_PAD_R,rt=YUZU_PAD_ZR,y=YUZU_PAD_X;
+    for(unsigned physical=0;physical<=0xffff;++physical){
+        for(unsigned drawn=0;drawn<=1;++drawn){
+            unsigned weapon=yuzu_combat_pad(physical,physical,drawn,0);
+            assert(!(weapon&rb)||((physical&rt)&&!(physical&YUZU_PAD_ZL)));
+        }
+    }
+    YuzuGroundDraw draw={0};
+    unsigned physical=rb|y;
+    unsigned reserved=yuzu_ground_draw_sample(&draw,physical,YUZU_DRAW_RED_GROUND,0,1);
+    assert(yuzu_zr_input(reserved,1,0)==rb);
+    assert(!yuzu_combat_pad(physical,reserved,0,0));
+    reserved=yuzu_ground_draw_sample(&draw,physical,YUZU_DRAW_RED_GROUND,0,5);
+    assert(draw.ready==YUZU_DRAW_CRIMSON&&!yuzu_combat_pad(physical,reserved,0,0));
+    WObservation o=obs();
+    o.state=1;o.drawn=0;o.base.magnitude=90;o.base.held=ML_X;
+    WState s={.actor=1,.epoch=1};
+    assert(w_sheathed_attack(&s,&o).source==W_CRIMSON_MOVING);
+    o.state=16;o.drawn=1;o.base.native_action=w_action(s.move);o.base.motion=0x500+s.slot;
+    for(unsigned f=0;f<=8;++f){
+        unsigned weapon=yuzu_combat_pad(physical,physical,1,0);
+        o.base.held=((weapon&rb)?ML_R:0)|((weapon&y)?ML_X:0);
+        o.base.animation_frame=f;++o.base.sample_sequence;
+        assert(w_step(&s,&o).move!=W_THRUST);
+    }
+    unsigned weapon=yuzu_combat_pad(rt|y,rt|y,1,0);
+    assert(weapon==(rb|y));
+    o.base.held=ML_R|ML_X;++o.base.sample_sequence;
+    assert(w_step(&s,&o).move==W_THRUST);
+    assert(yuzu_combat_pad(rb|rt,rb,0,0)==0); /* reserved RT */
+    assert(yuzu_combat_pad(rt,rt|y,1,0)==rb); /* replayed solo Y */
+    assert(yuzu_combat_pad(rt,rt,0,1)==rb); /* native aerial draw */
+    assert(!yuzu_combat_pad(0,0,1,0)); /* native-only guard replay */
+    puts("PASS: sprint cannot supply weapon RT; moving Crimson and deliberate thrust preserved");
+}
