@@ -0,0 +1,382 @@
+/* Presentation on GU's local-wireless network. The native game still owns
+ * actors, hit registration, position and action transitions on both machines. */
+typedef struct {
+    uint8_t length,family;
+    uint16_t port;
+    u32 address,padding[2];
+} OnlineAddress;
+typedef struct {
+    u32 address;
+    uint8_t mac[6],node,connected,remaining[52];
+} OnlineNode;
+typedef struct {
+    u32 intent[4],session[4];
+    uint8_t common[0x30],security[0x18];
+    OnlineNode nodes[8];
+    uint8_t tail[0x218];
+} OnlineLdn;
+_Static_assert(sizeof(OnlineLdn)==0x480 && __builtin_offsetof(OnlineLdn,nodes)==0x68,"LDN NetworkInfo");
+typedef struct {
+    u32 id;
+    uint16_t request;
+    uint8_t age,area;
+} OnlineCue;
+typedef struct {
+    u32 id;
+    uint16_t blade;
+    uint8_t target,type;
+    float radius,from[3],to[3];
+} OnlineContact;
+typedef struct {
+    u32 magic,session[4],sequence,entry;
+    uint16_t source;
+    uint8_t move,slot,area,version;
+    uint16_t reserved;
+    float frame,rate;
+    OnlineCue cues[8];
+    OnlineContact contact;
+} OnlinePose;
+typedef struct {
+    u32 address,sequence,entry,cue,actor,last_rx;
+    unsigned area,slot,motion,prior_motion,long_sword;
+    float frame,rate,length;
+    u32 last_contact,contact_time;
+    OnlineContact incoming;
+} OnlinePeer;
+static struct {
+    int fd;
+    u32 session[4],self,sequence,entry,last_send,source,last_cue,bind_serial,area,actor;
+    OnlinePeer peers[8];
+    OnlineCue cues[8];
+    u32 cue_time[8];
+    u32 contact_sequence,contact_time[4],contact_actor[4],contact_bind[4],last_active;
+    OnlineContact contacts[4];
+} online={.fd=-1};
+enum { ONLINE_MAGIC=0x31534c47,ONLINE_PORT=45871 };
+#define ONLINE_SDK(type,got) ((type)(uptr)word((void *)main_base,got))
+typedef int (*OnlineSocket)(int,int,int);
+typedef int (*OnlineBind)(int,const OnlineAddress *,unsigned);
+typedef int (*OnlineSend)(int,const void *,unsigned,int,const OnlineAddress *,unsigned);
+typedef int (*OnlineRecv)(int,void *,unsigned,int,OnlineAddress *,unsigned *);
+static int online_session_equal(const u32 *a,const u32 *b)
+{
+    return a[0]==b[0]&&a[1]==b[1]&&a[2]==b[2]&&a[3]==b[3];
+}
+static void online_release_pose(OnlinePeer *peer,void *actor);
+static void online_forget_peer(OnlinePeer *peer)
+{
+    void *players=(void *)(uptr)word((void *)main_base,0x1885b58);
+    if(players&&peer->motion&&peer->slot<4){
+        void *actor=(void *)(uptr)word(players,0x1c+4*peer->slot);
+        if(actor&&actor!=world_local_hunter())online_release_pose(peer,actor);
+    }
+    *peer=(OnlinePeer){0};
+}
+static void online_close(void)
+{
+    if(online.fd>=0){
+        for(unsigned i=0;i<8;++i)if(online.peers[i].address)online_forget_peer(online.peers+i);
+        ONLINE_SDK(int (*)(int),0x18382ac)(online.fd);
+        write_event("online_close",online.sequence,online.last_cue,0,0);
+    }
+    online=(__typeof__(online)){.fd=-1};
+}
+static int online_members(void)
+{
+    OnlineLdn info={0};
+    u32 local=0,mask=0;
+    if(ONLINE_SDK(u32 (*)(OnlineLdn *),0x18381fc)(&info)||
+       ONLINE_SDK(u32 (*)(u32 *,u32 *),0x18388d0)(&local,&mask)||!local)return 0;
+    if(online.fd>=0&&!online_session_equal(online.session,info.session))online_close();
+    if(online.fd<0){
+        online.fd=ONLINE_SDK(OnlineSocket,0x183829c)(2,2,0);
+        OnlineAddress listen={16,2,__builtin_bswap16(ONLINE_PORT),0,{0,0}};
+        int bound=online.fd<0?-1:ONLINE_SDK(OnlineBind,0x18382c0)(online.fd,&listen,sizeof(listen));
+        if(bound<0){write_event("online_bind_error",online.fd,bound,local,0);online_close();return 0;}
+        for(unsigned i=0;i<4;++i)online.session[i]=info.session[i];
+        online.self=__builtin_bswap32(local);
+        write_event("online_open",online.self,info.nodes[0].address,online.fd,0);
+    }
+    for(unsigned i=0;i<8;++i){
+        u32 address=info.nodes[i].connected?__builtin_bswap32(info.nodes[i].address):0;
+        if(address==online.self)address=0;
+        if(online.peers[i].address!=address){
+            online_forget_peer(online.peers+i);
+            online.peers[i].address=address;
+            write_event("online_member",i,address,info.nodes[i].node,0);
+        }
+    }
+    return 1;
+}
