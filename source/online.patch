+    if(!actor||actor==local||byte(actor,AREA)!=pose->area||(int16_t)u16(actor,HP)<=0){
+        peer->actor=peer->motion=peer->long_sword=peer->entry=0;
+        return;
+    }
+    if(peer->actor!=(uptr)actor||peer->area!=pose->area){
+        peer->actor=(uptr)actor;peer->area=pose->area;peer->entry=peer->motion=0;
+    }
