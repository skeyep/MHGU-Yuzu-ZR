+                else set_real(actor,0x50c,pose->rate);
+            }
+        }
+    }
+    for(unsigned i=0;i<8;++i){
+        const OnlineCue *cue=pose->cues+i;
+        if(!cue->id||(int32_t)(cue->id-peer->cue)<=0||cue->age>24||
+           cue->area!=pose->area||cue->request>RC114_ROUND_RANK)continue;
+        world_audio_load(local);
+        if(!world_audio_ready)break;
+        void *sm=*(void **)(main_base+0x1896f5c);
+        if(!sm)break;
+        ((void (*)(void *,u32,void *,u32,void *,const float *,void *))(main_base+0x4ee980))
+            (sm,byte(actor,0x111a)?13:12,world_audio_request,cue->request,actor,(const float *)((uptr)actor+0x40),actor);
+        peer->cue=cue->id;
+        write_event("remote_cue",pose->slot,cue->request,cue->id,pose->sequence);
+    }
+}
+static void world_trace_party(void *local);
+static void online_tick(void)
+{
+    static u32 next_check;
+    void *network=(void *)(uptr)word((void *)main_base,0x18843f0);
+    if(!network||!byte(network,0x63e)){if(online.fd>=0)online_close();next_check=0;return;}
+    if(!next_check||(int32_t)(sample_sequence-next_check)>=0){
+        if(!online_members()){if(online.fd>=0)online_close();next_check=sample_sequence+120;return;}
+        next_check=sample_sequence+60;
+    }
+    if(online.fd<0)return;
+    void *players=(void *)(uptr)word((void *)main_base,0x1885b58);
+    void *local=players?((void *(*)(void *))(main_base+0x276278))(players):0;
+    world_trace_party(local);
+    for(unsigned i=0;players&&i<8;++i){
+        OnlinePeer *peer=online.peers+i;
+        if(peer->motion&&sample_sequence-peer->last_rx>30&&peer->slot<4)
+            online_release_pose(peer,(void *)(uptr)word(players,0x1c+4*peer->slot));
+    }
+    OnlineAddress from;
+    for(unsigned i=0;i<8;++i){
+        OnlinePose packet;
+        unsigned size=sizeof(from);
+        int count=ONLINE_SDK(OnlineRecv,0x18382cc)(online.fd,&packet,sizeof(packet),0x80,&from,&size);
+        if(count<0)break;
+        if(count!=sizeof(packet)||size!=sizeof(from)||from.family!=2||
+           from.port!=__builtin_bswap16(ONLINE_PORT))continue;
+        for(unsigned j=0;j<8;++j)if(online.peers[j].address&&online.peers[j].address==from.address){
+            online_receive(local,players,online.peers+j,&packet);break;
+        }
+    }
+    /* GU can reset a proxy to drawn idle between two received updates.
+     * Keep its last confirmed clip moving during that short interval. */
+    for(unsigned i=0;players&&local&&i<8;++i){
+        OnlinePeer *p=online.peers+i;
+        unsigned age=sample_sequence-p->last_rx;
+        if(!p->motion||!age||age>4||p->slot>=4||p->area!=byte(local,AREA))continue;
+        void *actor=(void *)(uptr)word(players,0x1c+4*p->slot);
+        if(!actor||actor==local||p->actor!=(uptr)actor||p->area!=byte(actor,AREA)||
+           u16(actor,STATE)!=1||u16(actor,ACTION)>5||u16(actor,MOTION)!=0x501)continue;
+        float frame=p->frame+age*p->rate;
+        if(frame>=p->length)frame=p->length-1;
+        original_layer(actor,0,5000+(p->motion&255),0x81,2,frame,p->rate);
+    }
+    unsigned slot=4;
+    if(local)for(unsigned i=0;i<4;++i)if(word(players,0x1c+4*i)==(uptr)local){slot=i;break;}
+    unsigned area=local?byte(local,AREA):0;
+    unsigned active=local&&world.actor==(uptr)local&&world_bound&&world.move&&
+        u16(local,ACTION)==w_action(world.move)&&u16(local,MOTION)==0x500+world.slot;
+    unsigned source=active?world.source:0;
+    if(active)online.last_active=sample_sequence;
+    if(!active&&online.source&&local&&online.actor==(uptr)local&&online.area==area&&
+       world.actor==(uptr)local&&world.move&&u16(local,STATE)==16&&
+       sample_sequence-online.last_active<=3)return;
+    int changed=online.source!=source||online.actor!=(uptr)local||online.area!=area||
+                (active&&online.bind_serial!=world_bind_serial);
+    if(active)online.bind_serial=world_bind_serial;
+    if(changed){++online.entry;online.source=source;online.area=area;online.actor=(uptr)local;}
+    if(changed&&active&&world.move>=W_RISE&&world.move<=W_LAND)
+        write_event("online_air_pose",online.entry,word(local,0x40),word(local,0x44),word(local,0x48));
+    unsigned recent=online.last_cue&&sample_sequence-online.cue_time[online.last_cue%8]<24;
+    for(unsigned i=0;i<4;++i)if(online.contacts[i].id&&sample_sequence-online.contact_time[i]<18)recent=1;
+    if(!changed&&sample_sequence-online.last_send<(source||recent?4u:60u))return;
+    OnlinePose packet={.magic=ONLINE_MAGIC,.version=2,.sequence=++online.sequence,.entry=online.entry,
+                       .slot=slot,.area=area,.source=source,.move=active?world.move:0};
+    packet.reserved=local_long_sword(local);
+    if(active){packet.frame=real(local,FRAME);packet.rate=real(local,0x50c);}
+    for(unsigned i=0;i<4;++i)packet.session[i]=online.session[i];
+    for(unsigned i=0;i<8;++i){
+        unsigned index=(online.last_cue+1+i)%8;
+        if(online.cues[index].id&&sample_sequence-online.cue_time[index]<25){
+            packet.cues[i]=online.cues[index];packet.cues[i].age=sample_sequence-online.cue_time[index];
+        }
+    }
+    for(unsigned i=0;i<8;++i)if(online.peers[i].address){
+        unsigned target=online.peers[i].slot;
+        packet.contact=(OnlineContact){0};
+        if(target<4&&online.contact_actor[target]==online.peers[i].actor&&
+           sample_sequence-online.contact_time[target]<18)packet.contact=online.contacts[target];
+        OnlineAddress to={16,2,__builtin_bswap16(ONLINE_PORT),online.peers[i].address,{0,0}};
+        int sent=ONLINE_SDK(OnlineSend,0x18382d4)(online.fd,&packet,sizeof(packet),0,&to,sizeof(to));
+        if(changed||packet.sequence==1)write_event("online_tx",slot,source,packet.sequence,sent);
+    }
+    online.last_send=sample_sequence;
+}
+#undef ONLINE_SDK
+static unsigned online_sword_peer(void *actor)
+{
+    if(online.fd<0)return 0;
+    for(unsigned i=0;i<8;++i){
+        const OnlinePeer *peer=online.peers+i;
+        if(peer->address&&peer->long_sword&&peer->actor==(uptr)actor&&peer->slot<4&&
+           sample_sequence-peer->last_rx<=120)return peer->slot+1;
+    }
+    return 0;
+}
