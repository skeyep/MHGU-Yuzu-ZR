+    if(online.fd<0)return;
+    void *manager=*(void **)(main_base+0x2126d8c);
+    uptr start=(uptr)manager+64,at=(uptr)voice;
+    if(!manager||at<start||(at-start)%2784||(at-start)/2784>=128)return;
+    void *actor=(void *)(uptr)word(voice,20);
+    unsigned slot=online_sword_peer(actor);
+    if(!slot)return;
+    unsigned idx=(at-start)/2784,request=word(voice,16),serial=word(voice,52);
+    if(voices[idx].serial==serial&&voices[idx].actor==(uptr)actor&&voices[idx].request==request)return;
+    voices[idx]=(__typeof__(voices[0])){serial,(uptr)actor,request};
+    write_event("remote_voice",slot-1,request,serial,idx);
+}
