+    }
+    unsigned state=u16(actor,STATE),action=u16(actor,ACTION);
+    /* GU collapses a peer's private action to drawn idle (group 1/action 0).
+     * Keep native hit, item, cart and map transitions in control. */
+    int passive=state==1&&action<=5;
