+/* GU 16bb38 reads the hunter's registered capsule from collision slot 3260. */
+static unsigned online_body_capsule(void *manager,void *actor,float *body)
+{
+    unsigned index=word(actor,0x3260);
+    if(index>=256)return 0;
+    const void *record=(const void *)((uptr)manager+0x1c+index*32);
+    if(byte(record,0)!=2||!(real(record,4)>0))return 0;
+    for(unsigned k=0;k<3;++k){body[k]=real(record,8+4*k);body[k+4]=real(record,20+4*k);}
+    body[8]=real(record,4);
+    return 1;
+}
+static void online_blade_contacts(void *manager)
+{
+    if(online.fd<0)return;
+    void *local=world_local_hunter(),*players=(void *)(uptr)word((void *)main_base,0x1885b58);
+    if(!local||!players||(int16_t)u16(local,HP)<=0)return;
+    void *blade=(void *)((uptr)local+0x3020);
+    unsigned armed=world_attack_owned&&world_attack_actor==(uptr)local&&world_bound&&
+        world_attack_id==u16(blade,0x34)&&world.epoch==byte(local,AREA)&&
+        u16(local,MOTION)==0x500+world.slot&&byte(blade,5)&&word(blade,0xc)==(uptr)local;
+    for(unsigned i=0;i<8;++i){
+        OnlinePeer *p=online.peers+i;
+        if(!p->address||!p->actor||p->slot>=4||p->area!=byte(local,AREA)||
+           p->actor!=word(players,0x1c+4*p->slot)||sample_sequence-p->last_rx>120)continue;
+        void *other=(void *)(uptr)p->actor;
+        if(other==local||byte(other,AREA)!=p->area||(int16_t)u16(other,HP)<=0)continue;
+        OnlineContact *incoming=&p->incoming;
+        if(incoming->id){
+            float body[12]={0},shape[12]={0},point[4]={0};
+            unsigned type=incoming->type;
+            for(unsigned k=0;k<3;++k){shape[k]=incoming->from[k];shape[k+4]=incoming->to[k];}
+            unsigned valid=1;
+            for(unsigned k=0;k<3;++k)if(!(shape[k]>-1e7f&&shape[k]<1e7f&&
+                                           shape[k+4]>-1e7f&&shape[k+4]<1e7f))valid=0;
+            shape[type==1?3:8]=incoming->radius;
+            unsigned fn=type==1?0x168198:type==2?0x167b5c:0x1683dc;
+            if(valid&&sample_sequence-p->contact_time<=12&&online_body_capsule(manager,local,body)&&
+               ((unsigned (*)(const void *,const void *,void *))(main_base+fn))(shape,body,point)){
+                unsigned state=u16(local,STATE),action=u16(local,ACTION);
+                write_event("ally_blade_contact",p->slot,incoming->id,state<<16|action,incoming->blade);
+                if(state==64&&action==26){
+                    ((NativeCall)(main_base+0x2831e0))(local,1,0,0);
+                    write_event("ally_blade_wake",p->slot,incoming->id,u16(local,STATE),u16(local,ACTION));
+                }
+            }
+            incoming->id=0;
+        }
+        if(!armed)continue;
+        unsigned slot=p->slot;
+        OnlineContact *out=online.contacts+slot;
+        if(out->id&&out->blade==world_attack_id&&online.contact_bind[slot]==world_bind_serial&&
+           online.contact_actor[slot]==p->actor)continue;
+        float body[12]={0},shape[9]={0};
+        if(!online_body_capsule(manager,other,body))continue;
+        unsigned type=world_find_intersection(manager,blade,body,shape);
+        if(!type)continue;
+        *out=(OnlineContact){.id=++online.contact_sequence,.blade=world_attack_id,.target=slot,
+                            .type=type,.radius=shape[type==1?3:8]};
+        for(unsigned k=0;k<3;++k){out->from[k]=shape[k];out->to[k]=shape[k+4];}
+        online.contact_time[slot]=sample_sequence;online.contact_bind[slot]=world_bind_serial;
+        online.contact_actor[slot]=p->actor;
+        write_event("ally_blade_tx",slot,out->id,world.source,world_attack_id);
+    }
+}
