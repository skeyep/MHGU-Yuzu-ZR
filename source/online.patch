+    if(pose->source&&pose->move>=W_FORESIGHT&&pose->move<=W_FOCUS&&
+       (passive||(state==16&&action==w_action(pose->move)))){
+        const WClip *clip=w_clip(pose->source);
+        void *resource=(void *)(uptr)word(actor,0xf04+5*4);
+        void *bank=resource?(void *)(uptr)word(resource,0x64):0;
+        if(clip&&clip->slot&&bank&&word(bank,0)==0x00544d4c&&u16(bank,6)>clip->slot&&
+           word(bank,8+4*clip->slot)&&pose->frame>=0&&pose->frame<clip->length&&pose->rate>=0&&pose->rate<=8){
+            unsigned motion=u16(actor,MOTION);
+            peer->frame=pose->frame;peer->rate=pose->rate;peer->length=clip->length;
+            if(peer->entry!=pose->entry||motion!=0x500+clip->slot){
+                if(motion!=peer->motion&&motion!=0xffff)peer->prior_motion=motion;
+                original_layer(actor,0,5000+clip->slot,0x81,2,pose->frame,pose->rate);
+                if(u16(actor,MOTION)==0x500+clip->slot){
+                    if(peer->entry!=pose->entry){
+                        write_event("remote_bind",pose->slot,pose->source,pose->entry,clip->slot);
+                        if(pose->move>=W_RISE&&pose->move<=W_LAND)
+                            write_event("remote_air_pose",pose->entry,word(actor,0x40),word(actor,0x44),word(actor,0x48));
+                    }
+                    peer->entry=pose->entry;peer->motion=0x500+clip->slot;
+                }
+            }else{
+                float drift=real(actor,FRAME)-pose->frame;
+                if(drift>8||drift< -8)
