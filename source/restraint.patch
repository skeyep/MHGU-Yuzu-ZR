+static void world_yield_to_status(void *a,unsigned state,unsigned action)
+{
+    if(world_restrained_actor==a&&world_restrained_epoch==byte(a,AREA)&&!world.move&&world_armor<=0)return;
+    world_restrained_actor=a;world_restrained_epoch=byte(a,AREA);
+    unsigned source=world.source;
+    if(world.actor==(u32)(uptr)a&&world.epoch==byte(a,AREA)){
+        if(world.move>=W_RISE&&world.move<=W_LAND)
+            write_event("helm_interrupt_exit",(u32)(uptr)a,world.move,state,action);
+        if(world_air_owner(a))world_zero_velocity(a);
+        world_physics_end(a);
+        world_commit(a,w_leave(&world));
+        world_cleanup(a);
+        w_clear_player_input(&world);
+        world_follow_clear();
+        world_armor=0;
+#if ML_WILDS_MOVES
+        world_clear_player_input();
+        adept_run.actor=world_idle_actor=0;potion_draw.actor=0;
+        entry_turn.actor=roll_turn.actor=focus_thrust_turn.actor=0;
+        world_spirit_draw_actor=world_sprint_sheathe_actor=0;
+        world_iai_body_actor=helm_guard_ticks=world_loop_actor=0;
+#endif
+    }
+    write_event("native_status_enter",(u32)(uptr)a,state,action,source);
+}
+static void world_status_resumed(void *a)
+{
+    if(!world_restrained_actor)return;
+    if(world_restrained_actor==a&&world_restrained_epoch==byte(a,AREA))
+        write_event("native_status_resume",(u32)(uptr)a,u16(a,STATE),u16(a,ACTION),0);
+    world_restrained_actor=0;
+}
