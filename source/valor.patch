+static void valor_sheathe_and_gauge(void)
+{
+    for(unsigned blue=0;blue<2;++blue){
+        WObservation o;WState s;
+        set_valor_test_move(&s,&o,W_SMALL,blue);
+        assert(frame_step(&s,&o,ML_Y,24).kind==W_KEEP);
+        assert(frame_step(&s,&o,0,41).kind==W_KEEP);
+        assert(frame_step(&s,&o,0,42).kind==W_VALOR_SHEATHE&&!s.move);
+        set_valor_test_move(&s,&o,W_SMALL,blue);
+        assert(frame_step(&s,&o,ML_Y,55).kind==W_VALOR_SHEATHE);
+        set_valor_test_move(&s,&o,W_SMALL,blue);
+        assert(frame_step(&s,&o,ML_R|ML_B,25).kind==W_KEEP);
+        assert(frame_step(&s,&o,0,42).move==W_SHEATHE);
+        set_valor_test_move(&s,&o,W_SMALL,blue);
+        assert(frame_step(&s,&o,ML_Y,30).kind==W_KEEP);
+        o.base.bind_generation++;
+        assert(frame_step(&s,&o,0,42).kind!=W_VALOR_SHEATHE);
+        set_valor_test_move(&s,&o,W_SMALL,blue);
+        o.hunter_art_input=1;
+        assert(frame_step(&s,&o,ML_Y,50).kind!=W_VALOR_SHEATHE);
+        for(unsigned move=W_FORESIGHT;move<=W_BIG;++move){
+            if(move!=W_FORESIGHT&&move!=W_SMALL&&move!=W_BIG)continue;
+            for(unsigned contact=0;contact<2;++contact)for(unsigned counter=0;counter<2;++counter){
